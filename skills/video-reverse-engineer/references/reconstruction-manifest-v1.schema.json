{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/video-reverse-engineer/reconstruction-manifest-v1.schema.json",
  "title": "ReconstructionManifest v1",
  "type": "object",
  "required": ["schemaVersion", "source", "globalStyle", "narrative", "audio", "sequences", "shots", "reviewFlags"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["path", "duration", "width", "height", "fps"],
      "properties": {
        "path": {"type": "string"}, "duration": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "globalStyle": {"type": "object"}, "narrative": {"type": "object"},
    "audio": {"type": "object", "required": ["words", "events"]},
    "sequences": {"type": "array"},
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
    "reviewFlags": {"type": "array", "items": {"$ref": "#/$defs/reviewFlag"}}
  },
  "$defs": {
    "range": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}}},
    "shot": {
      "type": "object",
      "required": ["id", "range", "beats", "narrativeFunction", "voice", "composition", "camera", "subjects", "visibleExpression", "inferredNarrativeEmotion", "actions", "layers", "textElements", "transitionIn", "transitionOut", "continuityAnchors", "reconstruction", "confidence", "evidence"],
      "properties": {"id": {"type": "string", "pattern": "^shot-[0-9]{3,}$"}, "range": {"$ref": "#/$defs/range"}, "beats": {"type": "array"}}
    },
    "reviewFlag": {
      "type": "object", "required": ["id", "severity", "scope", "code", "message", "evidence"],
      "properties": {"severity": {"enum": ["info", "warning", "error"]}, "scope": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}}
    }
  }
}
